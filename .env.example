PORT=3000
SESSION_SECRET=replace_this_with_a_random_secret_at_least_32_characters_long
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stockflow
NODE_ENV=development
# Set these before the first start on an empty database to create the initial admin.
BOOTSTRAP_ADMIN_NAME=StockFlow Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_this_to_a_unique_password_10_to_72_chars
# Optional: free key from https://www.pexels.com/api/ for automatic product photos
PEXELS_API_KEY=
